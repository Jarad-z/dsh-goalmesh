{
  "name": "dsh-client-ui-goalmesh",
  "version": "0.3.0",
  "description": "DeepSeek Harness Web companion for durable GoalMesh trajectories.",
  "keywords": ["deepseek-harness", "dsh-plugin", "multi-agent", "goal-driven", "agent-observability"],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {"types": "./lib/types/index.d.ts", "default": "./lib/index.js"},
    "./client": {"types": "./lib/types/client/index.d.ts", "default": "./lib/client.js"},
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-runtime", "@deepseek-ai/dsh-client-ui-conversation"],
      "platform": "web"
    }
  },
  "files": ["lib/index.js", "lib/client.js", "lib/client.js.map", "lib/types/**/*.d.ts"],
  "dependencies": {"react": "^18.3.1"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.5",
    "dsh-tool-goalmesh": "^0.3.0"
  },
  "devDependencies": {"dsh-tool-goalmesh": "workspace:*"},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jarad-z/dsh-goalmesh.git",
    "directory": "packages/client-ui-goalmesh"
  },
  "homepage": "https://github.com/Jarad-z/dsh-goalmesh#readme",
  "bugs": {"url": "https://github.com/Jarad-z/dsh-goalmesh/issues"},
  "publishConfig": {"access": "public"},
  "license": "MIT"
}
